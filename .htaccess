# ==============================================================================
# ILMUNA WA BOT — PRODUCTION .HTACCESS (wa.ilmuna.my.id)
# Lingkungan Server: LiteSpeed / Apache / cPanel (User: uofruaju | PHP ea-php74 s/d 8.3)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECURITY HEADERS & GUARDIAN DOME WAF (Browser Pages)
#    Endpoint API (/api/v1/*) diisolasi di api/v1/.htaccess
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

<IfModule lsapi_module>
    php_value auto_prepend_file "/home/uofruaju/guardian-dome/guardian-dome-waf.php"
    php_value error_log "/home/uofruaju/logs/php.error.log"
    php_flag log_errors On
    php_flag display_errors Off
    php_value memory_limit 256M
    php_flag zlib.output_compression Off
</IfModule>

<IfModule php7_module>
    php_value auto_prepend_file "/home/uofruaju/guardian-dome/guardian-dome-waf.php"
    php_value error_log "/home/uofruaju/logs/php.error.log"
    php_flag log_errors On
    php_flag display_errors Off
    php_value memory_limit 256M
    php_flag zlib.output_compression Off
</IfModule>

# Lewati scan pre-flight Guardian Dome pada webhook WA & handshake SSO callback/SLO/logout
<FilesMatch "^(webhook|sso-callback|sso-slo|logout)\.php$">
    <IfModule lsapi_module>
        php_value auto_prepend_file none
    </IfModule>
    <IfModule php7_module>
        php_value auto_prepend_file none
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 1B. KOMPRESI GZIP & BROWSER CACHE ASET STATIS (FORMAT STANDAR LITESPEED learn/.htaccess)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault A0
    ExpiresByType text/css A31536000
    ExpiresByType text/javascript A31536000
    ExpiresByType application/javascript A31536000
    ExpiresByType image/png A31536000
    ExpiresByType image/webp A31536000
    ExpiresByType image/jpeg A31536000
    ExpiresByType image/svg+xml A31536000
    ExpiresByType image/x-icon A31536000
    ExpiresByType image/vnd.microsoft.icon A31536000
</IfModule>

<FilesMatch "\.(css|js|png|jpg|jpeg|webp|ico|svg|woff2?)$">
    <IfModule mod_headers.c>
        Header unset Pragma
        Header set Cache-Control "public, max-age=31536000"
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 2. PROTEKSI FILE SENSITIF & DIRECTORY BROWSING
# ------------------------------------------------------------------------------
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pertahankan header Authorization & X-Ilmuna-* untuk LiteSpeed/FastCGI/PHP-FPM
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Blokir akses langsung ke folder sensitif (core, workers, bridge, sdk, tests, logs)
    RewriteRule ^(core|workers|bridge|sdk|tests|logs|scratch)(/|$) - [F,L,NC]

    # Blokir akses langsung ke berkas konfigurasi, skema SQL, dokumentasi, & dotfile
    RewriteRule ^(config(\.local)?\.php|database\.php|auth\.php)$ - [F,L,NC]
    RewriteRule \.(sql|md|env|ini|log|bak|sh|ps1|git|lock)$ - [F,L,NC]

    # Clean URLs untuk endpoint utama, SSO & halaman dashboard
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^webhook/?$ webhook.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^login/?$ login.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^logout/?$ logout.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^sso-callback/?$ sso-callback.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^sso-slo/?$ sso-slo.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/v1/([a-zA-Z0-9_-]+)/?$ api/v1/$1.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^dashboard/([a-zA-Z0-9_-]+)/?$ dashboard/$1.php [L,QSA]
</IfModule>

# Lapisan proteksi tambahan jika mod_rewrite nonaktif
<FilesMatch "\.(sql|md|env|ini|log|bak|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(config(\.local)?|database|auth)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch ^(?i:\.ht.*)$>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule Litespeed>
    SetEnv noabort 1
</IfModule>
